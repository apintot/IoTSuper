<UserControl x:Class="IoTSuper_DesktopApp.Vistas.Cliente.ComponeneViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IoTSuper_DesktopApp.Vistas.Cliente"
             mc:Ignorable="d">

    <Border Background="{StaticResource scbTarjeta}" BorderThickness="1" CornerRadius="8">
        <Canvas Background="{StaticResource scbFondo}" AllowDrop="False">
                <Border Background="AliceBlue" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{StaticResource scbAzul}" BorderThickness="4" CornerRadius="20" Padding="10" Width="294" Height="81" Canvas.Left="676" Canvas.Top="58">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="{StaticResource ILcd}" Margin="0,0,50,0" x:Name="ImageLCD" MouseLeftButtonDown="ImageLCD_MouseLeftButtonDown" MouseLeftButtonUp="ImageLCD_MouseLeftButtonUp" AllowDrop="True"/>
                <Image Source="{StaticResource ITermometro}" x:Name="ImageTemperatura"/>
                <Image Source="{StaticResource IStock}" Margin="50,0,0,0" x:Name="ImageStock"/>
            </StackPanel>
        </Border>
            <Border ClipToBounds="True" BorderBrush="{StaticResource scbAzul}" BorderThickness="3" CornerRadius="20" Padding="0" Width="1625" Height="767" Canvas.Left="10" Canvas.Top="230" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource scbTarjeta}">
                <Canvas x:Name="ImagenCanvas" ClipToBounds="True" Width="1600">
                    <Image x:Name="imgAdd" Source="/Estilos/Imagenes/ImagenDefecto.png" Height="250" Canvas.Left="675" Canvas.Top="256" MouseEnter="Image_MouseEnter" MouseLeave="Image_MouseLeave" MouseUp="Image_MouseUp"/>
                    <Image x:Name="ImagenMovible" AllowDrop="True" Drop="ImagenMovible_Drop" MouseLeftButtonUp="ImagenMovible_MouseLeftButtonUp" Stretch="UniformToFill" MouseMove="ImagenMovible_MouseMove" MouseLeftButtonDown="ImagenMovible_MouseLeftButtonDown" HorizontalAlignment="Center" Height="741" Canvas.Left="10" Canvas.Top="10" VerticalAlignment="Top">
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="ImageTransform"/>
                        </Image.RenderTransform>
                    </Image>
                </Canvas>
            </Border>
        </Canvas>
    </Border>

</UserControl>
