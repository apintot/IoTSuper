<UserControl x:Class="IoTSuper_DesktopApp.Vistas.Cliente.CarruselCentro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controladores="clr-namespace:IoTSuper_DesktopApp.Controles"
             xmlns:local="clr-namespace:IoTSuper_DesktopApp.Vistas.Cliente"
             mc:Ignorable="d">
    <Grid Grid.Row="1" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="40,0,0,0">
                <controladores:Campo x:Name="txtBusqueda" Width="400" Icono="{StaticResource ILupa}" Placeholder="Busca el centro deseado" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Button Style="{StaticResource stlBotonPrincipal}"  HorizontalAlignment="Center" Margin="20,0,0,0" VerticalAlignment="Top" Width="100" Height="40" Click="BuscarCentroView_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Buscar" Foreground="White"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button Style="{StaticResource stlBotonPrincipal}" HorizontalAlignment="Right" Margin="0,50,40,0" VerticalAlignment="Top" Width="150" Click="CrearCentroView_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Crear centro" Foreground="White"/>
                    <TextBlock Text=" +" Foreground="White"/>
                </StackPanel>
            </Button>
            <UniformGrid Columns="3" x:Name="ContenedorCarusel"/>
            <Grid Margin="0,50,0,0">
                <Image x:Name="btnIzquierda" Source="{StaticResource IIzquierda}" Height="100" Cursor="Hand" HorizontalAlignment="Left" MouseLeftButtonUp="btnIzquierda_MouseLeftButtonUp"/>
                <Image x:Name="btnDerecha" Source="{StaticResource IDerecha}" Height="100" Cursor="Hand" HorizontalAlignment="Right" MouseLeftButtonUp="btnDerecha_MouseLeftButtonUp"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
