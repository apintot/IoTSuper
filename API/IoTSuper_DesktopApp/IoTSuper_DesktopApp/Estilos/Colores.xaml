<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

                    <!--Fondos-->
    <SolidColorBrush x:Key="scbFondo" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="scbTarjeta" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="scbFondoLateral" Color="#1F2937"/> <!--// #111827 #111827-->

    <Color x:Key="scbSombra">#AAAAAA</Color>

    <!--Texto-->
    <SolidColorBrush x:Key="scbTexto" Color="#000000"/> 
    
                    <!--Campo-->
    <SolidColorBrush x:Key="scbFondoCampo" Color="#F0F3FF"/>
    <SolidColorBrush x:Key="scbTextoCampo" Color="#D1D5DB"/>

    <!--Estados-->
    <SolidColorBrush x:Key="scbOk" Color="#10B981"/>
    <SolidColorBrush x:Key="scbError" Color="#EF4444"/>
    <SolidColorBrush x:Key="scbAdvertenciaStock" Color="#FBBF24"/>
    <SolidColorBrush x:Key="scbAdvertenciaTemperatura" Color="#F97316"/>

                    <!--Botones-->
    <SolidColorBrush x:Key="scbAzul" Color="#2563EB"/>
    <SolidColorBrush x:Key="scbAzulSobre" Color="#1D4ED8"/>

</ResourceDictionary>