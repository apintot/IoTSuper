<UserControl x:Class="IoTSuper_DesktopApp.Controladores.TarjetaSeccion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IoTSuper_DesktopApp.Controladores"
             mc:Ignorable="d" Width="400" Height="500">
    <Border x:Name="brdTarjeta" CornerRadius="14" Background="{StaticResource scbTarjeta}" Margin="6" Opacity="1">
        <Border.Effect>
            <DropShadowEffect Color="{StaticResource scbSombra}" BlurRadius="10" ShadowDepth="2" Opacity="1"/>
        </Border.Effect>
        <StackPanel>
            <Border x:Name="brdImagen" CornerRadius="14,14,0,0" ClipToBounds="True" Height="300" Background="White">
                <Image x:Name="ImgSeccion" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Margin="14,30,14,0">
                <TextBlock x:Name="txbTituloSeccion" Text="Seccion A" Style="{StaticResource stlTitulo}" FontSize="18" FontWeight="Bold" TextAlignment="Left" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Height="34">
                    <Border Background="White" CornerRadius="10" Padding="8,4" Margin="0,0,6,0" Height="32">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource scbSombra}" BlurRadius="10" ShadowDepth="1" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IIoT}" Height="20" Width="20" Margin="0,0,5,0"/>
                            <TextBlock Name="txbNumeroSensores" Text="8 " Style="{StaticResource stlSubtitulo}" Foreground="{StaticResource scbOk}" VerticalAlignment="Center" Width="20"/>
                            <TextBlock Text="Dispositivos" Style="{StaticResource stlCampo}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource stlBotonTicket}" HorizontalAlignment="Left"  Width="150" Click="VerSecciones_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ver Seccion" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <Border Background="Transparent" CornerRadius="6" Padding="8,7" Cursor="Hand" MouseLeftButtonUp="OtrasOpciones_MouseLeftButtonUp">
                        <TextBlock Text="•••" FontSize="16"/>
                    </Border>
                    <StackPanel x:Name="stkOpciones" Orientation="Horizontal" Width="75" Background="Transparent" Visibility="Collapsed" Opacity="0">
                        <Border Background="{StaticResource scbAdvertenciaStock}" Height="30" Width="30" CornerRadius="5" Margin="5,0,5,0">
                            <Image Source="{StaticResource IEdita}"
                                Width="15"
                                Cursor="Hand"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MouseLeftButtonUp="BtnEditarSeccion_MouseLeftButtonUp"/>
                        </Border>

                        <Border Background="{StaticResource scbError}" Height="30" Width="30" CornerRadius="5">
                            <Image Source="{StaticResource IElimina}"
                                   Width="18"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="BtnEliminarSeccion_MouseLeftButtonUp"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>

    </Border>
</UserControl>
