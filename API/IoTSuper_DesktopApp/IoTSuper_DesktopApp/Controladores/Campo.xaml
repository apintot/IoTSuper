<UserControl x:Class="IoTSuper_DesktopApp.Controles.Campo"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IoTSuper_DesktopApp.Controles"
             mc:Ignorable="d">
    <Border x:Name="camBorderBackground" Height="40" CornerRadius="8,8,0,0" Background="{StaticResource scbFondoCampo}" BorderBrush="Gray" BorderThickness="1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="{Binding Icono, ElementName=root}" Width="20" Height="20" Opacity="0.5" Margin="5,0,20,0"/>
            <Grid>
                <TextBlock x:Name="txbPlaceholder" Text="{Binding Placeholder, ElementName=root}" Style="{StaticResource stlCampo}"/>
                <TextBox x:Name="txtEntrada" Foreground="Black" Text="{Binding Texto, ElementName=root, UpdateSourceTrigger=PropertyChanged}" FontSize="15" VerticalAlignment="Center" Style="{StaticResource stlCampoBox}" Background="Transparent" BorderThickness="0" Visibility="Collapsed" TextChanged="txtEntrada_TextChanged"/>
                <PasswordBox x:Name="txtEntradaPassword" Background="Transparent" BorderThickness="0" Visibility="Collapsed" FontSize="15" VerticalAlignment="Center" PasswordChanged="txtEntradaPassword_PasswordChanged"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
